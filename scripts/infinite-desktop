#!/usr/bin/env python3
"""A small, input-safe infinite canvas for floating Hyprland windows.

The canvas is the set of non-pinned floating clients on the active workspace.
It never reads the keyboard.  Hyprland owns all keybinds; the optional mouse
drag reads only relative motion and the release of the button that began it.
"""

from __future__ import annotations

import json
import fcntl
from contextlib import contextmanager
import math
import os
import random
import re
import select
import shlex
import shutil
import uuid
import struct
import subprocess
import sys
import time
from pathlib import Path
from typing import Any


STEP = 180
DRAG_FPS = 60
DRAG_SPEED = 1.15
DEFAULT_SCATTER_SIZES = [(800, 600), (1040, 500), (1280, 400)]
SCATTER_X = 720
SCATTER_Y = 460
RANDOM_SCATTER_GAP_X = 180
RANDOM_SCATTER_GAP_Y = 140

EV_SYN = 0
EV_KEY = 1
EV_REL = 2
SYN_REPORT = 0
REL_X = 0
REL_Y = 1
BTN_LEFT = 272
BTN_RIGHT = 273
INPUT_EVENT = struct.Struct("@llHHi")

RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
STATE_FILES = (
    RUNTIME_DIR / f"infinite-desktop-{os.getuid()}.enabled",
    Path("/tmp") / f"infinite-desktop-{os.getuid()}.enabled",
)
INVERT_FILES = tuple(path.with_suffix(".inverted") for path in STATE_FILES)
LAYOUT_FILES = tuple(path.with_suffix(".layout.json") for path in STATE_FILES)
UI_STATE_FILE = RUNTIME_DIR / "velora-infinite-desktop.state"
WORKSPACE_STATE_FILE = RUNTIME_DIR / f"infinite-desktop-{os.getuid()}.workspaces.json"
MODE_LOCK = RUNTIME_DIR / f"infinite-desktop-{os.getuid()}.mode.lock"
DIRECTIONS = {
    "left": (-1, 0),
    "right": (1, 0),
    "up": (0, -1),
    "down": (0, 1),
}
DIRECTION_LETTERS = {"left": "l", "right": "r", "up": "u", "down": "d"}


class HyprlandError(RuntimeError):
    """An actionable problem reported to the user through a notification."""


class InputAccessError(HyprlandError):
    """The mouse cannot be read safely from this user session."""


def read_settings() -> tuple[float, list[tuple[int, int]], float]:
    """Read the same preferences as Settings once per gesture/action, never per frame."""
    path = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "velora-shell/config.json"
    try:
        document = json.loads(path.read_text())
        values = document.get("infiniteDesk", {}) if isinstance(document, dict) else {}
        if not isinstance(values, dict):
            values = {}
    except (OSError, ValueError):
        values = {}
    def finite(value):
        return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)
    speed = values.get("dragSensitivity", DRAG_SPEED)
    speed = max(.1, min(4., speed)) if finite(speed) else DRAG_SPEED
    sizes = []
    candidates = values.get("scatterSizes", [])
    for value in candidates if isinstance(candidates, list) else []:
        if not isinstance(value, dict) or not finite(value.get("width")) or not finite(value.get("height")):
            continue
        sizes.append((math.floor(max(320, min(7680, value["width"])) + .5),
                      math.floor(max(200, min(4320, value["height"])) + .5)))
    spacing = values.get("windowSpacing", 1.)
    spacing = max(0., min(3., spacing)) if finite(spacing) else 1.
    return float(speed), sizes or list(DEFAULT_SCATTER_SIZES), float(spacing)


def notify(message: str, force: bool = False) -> None:
    """Only state changes deserve a desktop notification, never navigation."""
    if not force:
        return
    try:
        subprocess.Popen(["notify-send", "Infinite Desktop", message],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        print("Infinite Desktop: " + message, file=sys.stderr)


def independent_workspaces() -> bool:
    path = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "velora-shell/config.json"
    try:
        value = json.loads(path.read_text()).get("infiniteDesk", {}).get("workspaceIndependent", True)
        return value if isinstance(value, bool) else True
    except (OSError, ValueError, AttributeError):
        return True


def current_workspace() -> int:
    identifier = int(hyprctl_json("activeworkspace")["id"])
    if identifier <= 0:
        raise HyprlandError("use uma workspace normal para alterar o Infinite Desk")
    return identifier


def read_modes(workspace: int | None = None) -> dict:
    try:
        data = json.loads(WORKSPACE_STATE_FILE.read_text())
        if not isinstance(data, dict) or not isinstance(data.get("workspaces"), dict):
            raise ValueError("invalid modes")
        modes = {str(int(key)): True for key, value in data["workspaces"].items()
                 if str(key).isdigit() and int(key) > 0 and value is True}
        state = {"version": 1, "independent": data.get("independent") is not False,
                 "global": data.get("global") is True, "workspaces": modes}
    except (OSError, ValueError):
        legacy = any(path.exists() for path in STATE_FILES)
        state = {"version": 1, "independent": True, "global": legacy,
                 "workspaces": {str(workspace or current_workspace()): True} if legacy else {}}
    independent = independent_workspaces()
    if state["independent"] and not independent:
        state["global"] = str(workspace or current_workspace()) in state["workspaces"]
    state["independent"] = independent
    return state


def mode_enabled(state: dict, workspace: int) -> bool:
    return str(workspace) in state["workspaces"] if state["independent"] else state["global"]


@contextmanager
def mode_lock():
    MODE_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with MODE_LOCK.open("a") as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        yield


def write_modes(state: dict) -> None:
    WORKSPACE_STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    temporary = WORKSPACE_STATE_FILE.with_suffix(".tmp")
    temporary.write_text(json.dumps(state, separators=(",", ":")))
    temporary.replace(WORKSPACE_STATE_FILE)
    set_marker(STATE_FILES, bool(state["workspaces"]) if state["independent"] else state["global"])


def sync_camera_modes(state: dict) -> None:
    scope = "workspace" if state["independent"] else "global"
    identifiers = " ".join(sorted(state["workspaces"], key=int))
    camera_action(f"scope {scope} {int(state['global'])}" + (" " + identifiers if identifiers else ""))


def enabled(monitor_name: str = "") -> bool:
    workspace = current_workspace() if not monitor_name else int(next(
        item for item in hyprctl_json("monitors") if item["name"] == monitor_name)["activeWorkspace"]["id"])
    return mode_enabled(read_modes(workspace), workspace)


def inverted() -> bool:
    return any(path.exists() for path in INVERT_FILES)


def set_marker(paths: tuple[Path, ...], value: bool) -> None:
    if not value:
        for path in paths:
            try:
                path.unlink(missing_ok=True)
            except OSError:
                pass
        return
    for path in paths:
        try:
            path.touch(exist_ok=True)
            return
        except OSError:
            continue
    raise HyprlandError("não foi possível salvar o estado do canvas")


def publish_ui_state(state: dict | None = None) -> str:
    """Publish the whole registry; QML selects locally on workspace changes."""
    state = state or read_modes()
    payload = json.dumps(state, separators=(",", ":")) + "\n"
    temporary = UI_STATE_FILE.with_suffix(".tmp")
    try:
        temporary.write_text(payload)
        temporary.replace(UI_STATE_FILE)
    except OSError as error:
        raise HyprlandError("não foi possível sincronizar o estado com o Velora") from error
    return payload.strip()


def read_layouts() -> dict[str, Any]:
    for path in LAYOUT_FILES:
        try:
            data = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if isinstance(data, dict) and isinstance(data.get("workspaces"), dict):
            return data
    return {"workspaces": {}}


def write_layouts(data: dict[str, Any]) -> None:
    serialized = json.dumps(data, separators=(",", ":"))
    for path in LAYOUT_FILES:
        temporary = path.with_suffix(".layout.tmp")
        try:
            temporary.write_text(serialized)
            temporary.replace(path)
            return
        except OSError:
            try:
                temporary.unlink(missing_ok=True)
            except OSError:
                pass
    raise HyprlandError("não foi possível salvar o layout do canvas")


def window_id(window: dict[str, Any]) -> str:
    """A Hyprland stableId survives floating/tiled changes in the same session."""
    return str(window.get("stableId") or window["address"])


def save_canvas_layout(workspace_id: int | None = None) -> tuple[int, str]:
    if workspace_id is None:
        workspace_id = current_workspace()
    clients = hyprctl_json("clients")
    windows = [
        client
        for client in clients
        if client.get("floating")
        and not client.get("pinned")
        and client.get("workspace", {}).get("id") == workspace_id
    ]
    focused = hyprctl_json("activewindow")
    layouts = read_layouts()
    layouts["workspaces"][str(workspace_id)] = {
        "windows": [
            {
                "id": window_id(window),
                "address": window["address"],
                "at": window["at"],
                "size": window["size"],
            }
            for window in windows
        ],
        "focused": window_id(focused) if focused.get("address") else None,
    }
    write_layouts(layouts)
    return len(windows), str(workspace_id)


def restore_canvas_layout(workspace_id: int | None = None) -> int:
    if workspace_id is None:
        workspace_id = current_workspace()
    record = read_layouts()["workspaces"].get(str(workspace_id))
    if not isinstance(record, dict):
        return 0
    visible_clients = {
        window_id(client): client
        for client in hyprctl_json("clients")
        if client.get("mapped")
        and client.get("workspace", {}).get("id") == workspace_id
    }
    commands: list[str] = []
    restored = 0
    for saved in record.get("windows", []):
        if not isinstance(saved, dict):
            continue
        client = visible_clients.get(str(saved.get("id")))
        at, size = saved.get("at"), saved.get("size")
        if not client or not isinstance(at, list) or not isinstance(size, list):
            continue
        if len(at) != 2 or len(size) != 2:
            continue
        address = client["address"]
        commands.extend(
            [
                f"dispatch setfloating address:{address}",
                f"dispatch resizewindowpixel exact {round(size[0])} {round(size[1])},address:{address}",
                f"dispatch movewindowpixel exact {round(at[0])} {round(at[1])},address:{address}",
            ]
        )
        restored += 1
    focused_id = record.get("focused")
    focused = visible_clients.get(str(focused_id)) if focused_id else None
    if focused and current_workspace() == workspace_id:
        commands.append(f"dispatch focuswindow address:{focused['address']}")
    hyprctl_batch(commands)
    return restored


def tile_canvas_windows(workspace_id: int | None = None) -> int:
    if workspace_id is None:
        workspace_id = current_workspace()
    windows = [
        client
        for client in hyprctl_json("clients")
        if client.get("floating")
        and not client.get("pinned")
        and client.get("workspace", {}).get("id") == workspace_id
    ]
    hyprctl_batch(
        [f"dispatch settiled address:{window['address']}" for window in windows]
    )
    return len(windows)


def toggle(announce_activation: bool = True) -> int:
    with mode_lock():
        workspace = current_workspace()
        state = read_modes(workspace)
        sync_camera_modes(state)
        active = mode_enabled(state, workspace)
        # Pin all camera commands to the captured monitor. A focus change while
        # waiting for IPC must not redirect the action to a different workspace.
        monitors = hyprctl_json("monitors")
        monitor = next((item["name"] for item in monitors
                        if item.get("activeWorkspace", {}).get("id") == workspace), "")
        if not monitor:
            raise HyprlandError("a workspace mudou durante a alteração; tente novamente")
        camera_action(("disable" if active else "enable") + f" {workspace}", monitor)
        if state["independent"]:
            if active: state["workspaces"].pop(str(workspace), None)
            else: state["workspaces"][str(workspace)] = True
        else:
            state["global"] = not active
        write_modes(state)
        publish_ui_state(state=state)
        if active:
            saved, _ = save_canvas_layout(workspace)
            tile_canvas_windows(workspace)
            print(f"Infinite desktop: workspace {workspace} disabled ({saved} janelas salvas)")
        else:
            restored = restore_canvas_layout(workspace)
            if announce_activation: notify("Canvas ativado", force=True)
            print(f"Infinite desktop: workspace {workspace} enabled ({restored} janelas restauradas)")
    return 0


def toggle_invert() -> int:
    new_state = not inverted()
    set_marker(INVERT_FILES, new_state)
    notify("Direção invertida" if new_state else "Direção normal")
    return 0


def require_enabled(monitor_name: str = "") -> bool:
    if enabled(monitor_name) if monitor_name else enabled():
        return True
    notify("Canvas desativado — use Super + Z")
    return False


def sync_state() -> int:
    with mode_lock():
        state = read_modes()
        sync_camera_modes(state)
        write_modes(state)
        print(publish_ui_state(state=state), flush=True)
    return 0


def hyprctl_json(command: str) -> Any:
    result = subprocess.run(
        ["hyprctl", "-j", command], text=True, capture_output=True, check=False
    )
    if result.returncode:
        raise HyprlandError(result.stderr.strip() or "Hyprland não está acessível")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise HyprlandError("Hyprland retornou uma resposta inválida") from error


def lua_dispatch(command: str) -> str:
    """Translate only the existing canvas actions to Hyprland's Lua API."""
    if not command.startswith("dispatch "):
        raise HyprlandError("comando de canvas não suportado")
    name, _, arguments = command[len("dispatch "):].partition(" ")
    if name == "velora-blur:infinite-camera":
        return "hl.plugin.velora.dispatch(\"infinite-camera\"," + json.dumps(arguments) + ")"
    if name == "movefocus":
        direction = {"l": "left", "r": "right", "u": "up", "d": "down"}.get(arguments)
        if direction:
            return "hl.dsp.focus({direction=" + json.dumps(direction) + "})"
    if name == "workspace":
        return "hl.dsp.focus({workspace=" + json.dumps(arguments) + "})"
    if name == "focuswindow":
        return "hl.dsp.focus({window=" + json.dumps(arguments) + "})"
    if name in ("setfloating", "settiled"):
        return "hl.dsp.window.float({action=" + json.dumps("set" if name == "setfloating" else "unset") + ",window=" + json.dumps(arguments) + "})"
    if name == "movecursor" and re.fullmatch(r"-?\d+ -?\d+", arguments):
        x, y = arguments.split()
        return f"hl.dsp.cursor.move({{x={x},y={y}}})"
    if name in ("movewindowpixel", "resizewindowpixel"):
        match = re.fullmatch(r"exact (-?\d+) (-?\d+),address:(0x[0-9a-fA-F]+)", arguments)
        if match:
            x, y, address = match.groups()
            method = "move" if name == "movewindowpixel" else "resize"
            return f"hl.dsp.window.{method}({{x={x},y={y},relative=false,window=" + json.dumps("address:" + address) + "})"
    raise HyprlandError("ação de canvas não suportada pelo transporte Lua: " + command)


_hyprland_backend = None


def hyprctl_batch(commands: list[str]) -> None:
    if not commands:
        return
    global _hyprland_backend
    if _hyprland_backend is None:
        info = subprocess.run(["hyprctl", "systeminfo"], text=True, capture_output=True, timeout=10)
        if info.returncode:
            raise HyprlandError("não foi possível identificar o transporte Hyprland")
        _hyprland_backend = "lua" if "configProvider: lua" in info.stdout else "legacy"
    if _hyprland_backend == "lua":
        payload = " ".join(lua_dispatch(item) if item.startswith("dispatch velora-blur:infinite-camera ")
                           else "hl.dispatch(" + lua_dispatch(item) + ")" for item in commands)
        arguments = ["hyprctl", "eval", payload]
    else:
        arguments = ["hyprctl", "--batch", " ; ".join(commands)]
    result = subprocess.run(
        arguments,
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode or any(message in result.stdout.lower() for message in ("error:", "invalid dispatcher", "unknown dispatcher")):
        raise HyprlandError(result.stderr.strip() or result.stdout.strip())


def camera_action(action: str, monitor_name: str = "") -> None:
    """Move the native viewpoint; client geometry stays in world coordinates."""
    if monitor_name:
        action = "@" + monitor_name + " " + action
    hyprctl_batch(["dispatch velora-blur:infinite-camera " + action])


def camera_center(window: dict[str, Any]) -> None:
    x, y = center(window)
    camera_action(f"center {x:.6f} {y:.6f}")
    hyprctl_batch([f"dispatch focuswindow address:{window['address']}"])


def center(window: dict[str, Any]) -> tuple[float, float]:
    return (
        window["at"][0] + window["size"][0] / 2,
        window["at"][1] + window["size"][1] / 2,
    )


def active_canvas(monitor_name: str = "") -> tuple[list[dict[str, Any]], dict[str, Any] | None, tuple[float, float]]:
    monitors = hyprctl_json("monitors")
    if not monitors:
        raise HyprlandError("nenhum monitor ativo foi encontrado")
    if monitor_name:
        monitor = next((item for item in monitors if item.get("name") == monitor_name), None)
        if monitor is None:
            raise HyprlandError("monitor do canvas não está disponível")
        workspace = monitor["activeWorkspace"]
    else:
        monitor = next((item for item in monitors if item.get("focused")), monitors[0])
        workspace = hyprctl_json("activeworkspace")
    workspace_id = workspace["id"]
    clients = hyprctl_json("clients")
    windows = [
        client
        for client in clients
        if client.get("floating")
        and not client.get("pinned")
        and client.get("workspace", {}).get("id") == workspace_id
    ]
    focused = hyprctl_json("activewindow")
    width, height = monitor["width"], monitor["height"]
    if monitor.get("transform", 0) % 2:
        width, height = height, width
    scale = monitor.get("scale", 1) or 1
    screen_center = (
        monitor["x"] + width / scale / 2,
        monitor["y"] + height / scale / 2,
    )
    return windows, focused, screen_center


def float_active_workspace_clients() -> int:
    """Promote regular windows in the active workspace into the canvas."""
    workspace = hyprctl_json("activeworkspace")
    workspace_id = workspace["id"]
    clients = hyprctl_json("clients")
    targets = [
        client
        for client in clients
        if client.get("mapped")
        and not client.get("pinned")
        and client.get("workspace", {}).get("id") == workspace_id
        and not client.get("floating")
    ]
    hyprctl_batch(
        [f"dispatch setfloating address:{client['address']}" for client in targets]
    )
    return len(targets)


def cursor_position() -> tuple[float, float]:
    position = hyprctl_json("cursorpos")
    return float(position["x"]), float(position["y"])


def contains_point(window: dict[str, Any], point: tuple[float, float]) -> bool:
    x, y = point
    left, top = window["at"]
    width, height = window["size"]
    return left <= x < left + width and top <= y < top + height


def cursor_over_client(point: tuple[float, float]) -> bool:
    """True for any visible Hyprland client, floating or tiled."""
    camera = hyprctl_json("velora-infinite-camera-status")
    if camera.get("enabled"):
        monitors = hyprctl_json("monitors")
        for view in camera.get("views", []):
            monitor = next((m for m in monitors if m.get("name") == view.get("monitor")), None)
            if not monitor or not view.get("active"):
                continue
            local_x, local_y = point[0] - monitor["x"], point[1] - monitor["y"]
            width, height = view["viewport"]
            if 0 <= local_x < width and 0 <= local_y < height:
                point = ((local_x - width / 2) / view["zoom"] + view["center"][0],
                         (local_y - height / 2) / view["zoom"] + view["center"][1])
                break
    for client in hyprctl_json("clients"):
        if (
            client.get("mapped")
            and client.get("visible")
            and client.get("at")
            and client.get("size")
            and contains_point(client, point)
        ):
            return True
    return False


def dispatch_positions(
    positions: dict[str, tuple[float, float]], focus: str | None = None
) -> None:
    commands = [
        f"dispatch movewindowpixel exact {round(x)} {round(y)},address:{address}"
        for address, (x, y) in positions.items()
    ]
    if focus:
        commands.append(f"dispatch focuswindow address:{focus}")
    hyprctl_batch(commands)


def choose_neighbor(
    windows: list[dict[str, Any]], origin: tuple[float, float], direction: str
) -> dict[str, Any] | None:
    vx, vy = DIRECTIONS[direction]
    candidates: list[tuple[float, dict[str, Any]]] = []
    for window in windows:
        wx, wy = center(window)
        dx, dy = wx - origin[0], wy - origin[1]
        forward = dx * vx + dy * vy
        if forward <= 1:
            continue
        perpendicular = abs(dx * vy - dy * vx)
        candidates.append((forward + 2.5 * perpendicular, window))
    return min(candidates, key=lambda item: item[0])[1] if candidates else None


def focus_direction(direction: str) -> int:
    # Super+arrows retain the normal Hyprland navigation until the canvas is on.
    if not enabled():
        hyprctl_batch([f"dispatch movefocus {DIRECTION_LETTERS[direction]}"])
        return 0
    windows, focused, screen_center = active_canvas()
    if not windows:
        notify("Não há janelas flutuantes neste workspace")
        return 1
    focused_address = focused.get("address") if focused else None
    current = next((window for window in windows if window["address"] == focused_address), None)
    origin = center(current) if current else screen_center
    target = choose_neighbor(
        [window for window in windows if window is not current], origin, direction
    )
    if not target:
        notify(f"Não há janela à {direction}")
        return 1
    camera_center(target)
    return 0


def center_focused() -> int:
    """Put the currently focused floating client at the monitor centre."""
    if not require_enabled():
        return 1
    windows, focused, screen_center = active_canvas()
    focused_address = focused.get("address") if focused else None
    target = next(
        (window for window in windows if window["address"] == focused_address), None
    )
    if not target:
        notify("Foque uma janela flutuante para centralizá-la")
        return 1
    camera_center(target)
    return 0


def focus_address(address: str) -> int:
    """Centre a specific canvas client and focus it.

    This is the non-interactive counterpart of directional navigation.  It is
    used by integrations such as Velyrics, where the next window is selected
    by a coordinator rather than by the currently focused client.
    """
    if not require_enabled():
        return 1
    windows, _, screen_center = active_canvas()
    target = next(
        (window for window in windows if str(window.get("address")) == address),
        None,
    )
    if not target:
        # Do not focus an arbitrary non-canvas window supplied by a caller.
        # Velyrics redirects this command's output, so keep failure quiet.
        return 1
    camera_center(target)
    return 0


def pan_direction(direction: str) -> int:
    if not require_enabled():
        return 1
    windows, _, _ = active_canvas()
    if not windows:
        notify("Não há janelas flutuantes neste workspace")
        return 1
    vx, vy = DIRECTIONS[direction]
    # A viewpoint moving left makes the canvas move right.
    sign = 1 if inverted() else -1
    camera_action(f"pan {sign * vx * STEP} {sign * vy * STEP}")
    return 0


def pointer_candidates() -> list[Path]:
    explicit = os.environ.get("INFINITE_DESKTOP_POINTER")
    candidates: list[Path] = [Path(explicit)] if explicit else []
    by_id = Path("/dev/input/by-id")
    if by_id.is_dir():
        candidates.extend(sorted(by_id.glob("*-event-mouse")))
    for device in sorted(Path("/dev/input").glob("event*")):
        capability = Path("/sys/class/input") / device.name / "device/capabilities/rel"
        try:
            relative_axes = int(capability.read_text().strip(), 16)
        except (OSError, ValueError):
            continue
        if relative_axes & 0b11 == 0b11:
            candidates.append(device)
    unique: list[Path] = []
    seen: set[Path] = set()
    for candidate in candidates:
        resolved = candidate.resolve()
        if resolved not in seen:
            seen.add(resolved)
            unique.append(candidate)
    return unique


def open_pointer() -> tuple[int, Path]:
    candidates = pointer_candidates()
    if not candidates:
        raise InputAccessError("nenhum mouse com movimento relativo foi encontrado")
    errors: list[str] = []
    for device in candidates:
        try:
            return os.open(device, os.O_RDONLY | os.O_NONBLOCK), device
        except OSError as error:
            errors.append(f"{device.name}: {error.strerror}")
    hint = "entre no grupo input e encerre/inicie a sessão"
    raise InputAccessError(f"sem acesso ao mouse ({hint})")


def drag_canvas(empty_only: bool = False, release_button: int = BTN_LEFT) -> int:
    """Move a frozen snapshot of the canvas until its initiating button releases."""
    if not require_enabled():
        return 1
    windows, _, _ = active_canvas()
    if not windows:
        notify("Não há janelas flutuantes neste workspace")
        return 1
    if empty_only and cursor_over_client(cursor_position()):
        # The non-consuming bind leaves the right-click untouched for the client.
        return 0
    speed, _, _ = read_settings()
    fd, device = open_pointer()
    pending_x = 0.0
    pending_y = 0.0
    packet = b""
    interval = 1 / DRAG_FPS
    last_flush = time.monotonic()
    direction = -1 if inverted() else 1
    print(f"Infinite desktop: dragging with {device}")

    def flush() -> None:
        nonlocal pending_x, pending_y, last_flush
        dx = pending_x * speed * direction
        dy = pending_y * speed * direction
        pending_x = 0.0
        pending_y = 0.0
        last_flush = time.monotonic()
        if not dx and not dy:
            return
        camera_action(f"pan {dx:.6f} {dy:.6f}")

    try:
        while True:
            timeout = max(0.0, interval - (time.monotonic() - last_flush))
            readable, _, _ = select.select([fd], [], [], timeout)
            if not readable:
                flush()
                continue
            data = os.read(fd, 4096)
            if not data:
                raise InputAccessError("a conexão com o mouse foi encerrada")
            packet += data
            while len(packet) >= INPUT_EVENT.size:
                event, packet = packet[: INPUT_EVENT.size], packet[INPUT_EVENT.size :]
                _, _, event_type, code, value = INPUT_EVENT.unpack(event)
                if event_type == EV_REL and code == REL_X:
                    pending_x += value
                elif event_type == EV_REL and code == REL_Y:
                    pending_y += value
                elif event_type == EV_KEY and code == release_button and value == 0:
                    flush()
                    return 0
                elif event_type == EV_SYN and code == SYN_REPORT:
                    if time.monotonic() - last_flush >= interval:
                        flush()
    finally:
        os.close(fd)


def drag_empty_canvas() -> int:
    return drag_canvas(empty_only=True, release_button=BTN_RIGHT)


def stream_drag_canvas(monitor_name: str = "") -> int:
    """Pan from relative MOVE records sent by the Quickshell desktop surface."""
    if not (require_enabled(monitor_name) if monitor_name else require_enabled()):
        return 1
    windows, _, _ = active_canvas(monitor_name) if monitor_name else active_canvas()
    if not windows:
        notify("Não há janelas flutuantes neste workspace")
        return 1

    speed, _, _ = read_settings()
    pending_x = 0.0
    pending_y = 0.0
    packet = b""
    interval = 1 / DRAG_FPS
    last_flush = time.monotonic()
    direction = -1 if inverted() else 1

    def flush() -> None:
        nonlocal pending_x, pending_y, last_flush
        dx = pending_x * speed * direction
        dy = pending_y * speed * direction
        pending_x = 0.0
        pending_y = 0.0
        last_flush = time.monotonic()
        if not dx and not dy:
            return
        if monitor_name:
            camera_action(f"pan {dx:.6f} {dy:.6f}", monitor_name)
        else:
            camera_action(f"pan {dx:.6f} {dy:.6f}")

    print("READY", flush=True)
    finished = False
    while not finished:
        timeout = max(0.0, interval - (time.monotonic() - last_flush))
        readable, _, _ = select.select([sys.stdin.fileno()], [], [], timeout)
        if readable:
            data = os.read(sys.stdin.fileno(), 4096)
            if not data:
                finished = True
            else:
                packet += data
                while b"\n" in packet:
                    record, packet = packet.split(b"\n", 1)
                    fields = record.decode("utf-8", errors="replace").strip().split()
                    if not fields:
                        continue
                    if fields == ["END"]:
                        finished = True
                        break
                    if len(fields) != 3 or fields[0] != "MOVE":
                        continue
                    try:
                        dx, dy = float(fields[1]), float(fields[2])
                    except ValueError:
                        continue
                    if math.isfinite(dx) and math.isfinite(dy):
                        pending_x += dx
                        pending_y += dy
        if finished or time.monotonic() - last_flush >= interval:
            flush()
    return 0


def zoom_canvas(mode: str) -> int:
    """Zoom the native camera without resizing or repositioning clients."""
    if not enabled():
        # Preserve the previous Super+wheel workspace navigation while disabled.
        offset = "e+1" if mode == "out" else "e-1"
        hyprctl_batch([f"dispatch workspace {offset}"])
        return 0
    windows, focused, screen_center = active_canvas()
    if not windows:
        notify("Não há janelas flutuantes neste workspace")
        return 1
    camera_action("zoom " + mode)
    return 0


def scatter_canvas() -> int:
    """Spread current floating windows into a two-dimensional starting layout."""
    if not require_enabled():
        return 1
    windows, focused, screen_center = active_canvas()
    if not windows:
        notify("Não há janelas flutuantes neste workspace")
        return 1
    ordered = sorted(windows, key=lambda window: window["address"])
    columns = max(2, math.ceil(math.sqrt(len(ordered))))
    rows = math.ceil(len(ordered) / columns)
    positions: dict[str, tuple[float, float]] = {}
    for index, window in enumerate(ordered):
        column, row = index % columns, index // columns
        target_center_x = screen_center[0] + (column - (columns - 1) / 2) * SCATTER_X
        target_center_y = screen_center[1] + (row - (rows - 1) / 2) * SCATTER_Y
        positions[window["address"]] = (
            target_center_x - window["size"][0] / 2,
            target_center_y - window["size"][1] / 2,
        )
    focus = focused.get("address") if focused else None
    dispatch_positions(positions, focus)
    notify(f"Canvas organizado: {len(ordered)} janelas")
    return 0


def scatter_random_canvas() -> int:
    """Arrange and resize canvas windows organically without overlap."""
    if not enabled():
        toggle(announce_activation=False)
    float_active_workspace_clients()
    windows, focused, screen_center = active_canvas()
    if not windows:
        return 1

    rng = random.SystemRandom()
    _, presets, spacing = read_settings()
    rng.shuffle(presets)
    choices = [presets[index % len(presets)] for index in range(len(windows))]
    rng.shuffle(choices)
    sizes = {window["address"]: size for window, size in zip(windows, choices)}
    max_width = max(float(sizes[window["address"]][0]) for window in windows)
    max_height = max(float(sizes[window["address"]][1]) for window in windows)
    base_radius = max(max_width * 1.25, max_height * 2.0) * (.5 + spacing * .5)
    clearance_x = RANDOM_SCATTER_GAP_X / 2 * spacing
    clearance_y = RANDOM_SCATTER_GAP_Y / 2 * spacing
    positions: dict[str, tuple[float, float]] = {}
    placed: list[tuple[float, float, int, int]] = []
    ordered = list(windows)
    rng.shuffle(ordered)
    for window in ordered:
        width, height = sizes[window["address"]]
        for attempt in range(1200):
            radius = rng.uniform(0, base_radius * (1 + attempt // 180))
            angle = rng.uniform(0, math.tau)
            x = screen_center[0] + math.cos(angle) * radius - width / 2
            y = screen_center[1] + math.sin(angle) * radius - height / 2
            if all(
                x + width + clearance_x <= other_x
                or other_x + other_width + clearance_x <= x
                or y + height + clearance_y <= other_y
                or other_y + other_height + clearance_y <= y
                for other_x, other_y, other_width, other_height in placed
            ):
                positions[window["address"]] = (x, y)
                placed.append((x, y, width, height))
                break
        else:
            raise HyprlandError("não foi possível encontrar espaço livre para organizar as janelas")
    focus = focused.get("address") if focused else None
    commands = []
    for address, (x, y) in positions.items():
        width, height = sizes[address]
        commands.append(f"dispatch resizewindowpixel exact {width} {height},address:{address}")
        commands.append(f"dispatch movewindowpixel exact {round(x)} {round(y)},address:{address}")
    if focus:
        commands.append(f"dispatch focuswindow address:{focus}")
    hyprctl_batch(commands)
    return 0


def status() -> int:
    candidates = pointer_candidates()
    print(f"enabled={enabled()}")
    print(f"inverted={inverted()}")
    print("pointer=" + (str(candidates[0]) if candidates else "not-found"))
    return 0


def terminal_rectangle(monitor_name: str, workspace: int, values: list[float]) -> int:
    """Open one identifiable Kitty; never resize or focus an unrelated client."""
    if len(values) != 4 or not all(math.isfinite(v) for v in values):
        raise HyprlandError("retângulo inválido")
    x, y, width, height = (round(v) for v in values)
    if workspace <= 0 or not 16 <= width <= 32768 or not 16 <= height <= 32768 or max(abs(x), abs(y)) > 10000000:
        raise HyprlandError("retângulo fora dos limites")
    monitor = next((m for m in hyprctl_json("monitors") if m.get("name") == monitor_name), None)
    if not monitor or monitor.get("activeWorkspace", {}).get("id") != workspace or current_workspace() != workspace:
        return 0
    if not enabled(monitor_name):
        return 0
    kitty = shutil.which("kitty")
    if not kitty:
        raise HyprlandError("Kitty não está instalado")
    identity = "velora-drawn-" + uuid.uuid4().hex
    command = shlex.join([kitty, "--class", identity, "--override", "remember_window_size=no",
                          "--override", f"initial_window_width={width}",
                          "--override", f"initial_window_height={height}"])
    # Detect the same transport used by the canvas dispatchers.
    global _hyprland_backend
    if _hyprland_backend is None:
        info = subprocess.run(["hyprctl", "systeminfo"], text=True, capture_output=True, timeout=10)
        if info.returncode:
            raise HyprlandError("não foi possível identificar o transporte Hyprland")
        _hyprland_backend = "lua" if "configProvider: lua" in info.stdout else "legacy"
    if _hyprland_backend == "lua":
        rules = ("{float=true,no_initial_focus=true,workspace=" + json.dumps(f"{workspace} silent")
                 + ",monitor=" + json.dumps(monitor_name) + f",size={{{width},{height}}}"
                 + f",move={{{x - monitor['x']},{y - monitor['y']}}}" + "}")
        arguments = ["hyprctl", "eval", "hl.exec_cmd(" + json.dumps(command) + "," + rules + ")"]
    else:
        rules = f"[float;noinitialfocus;workspace {workspace} silent;monitor {monitor_name};size {width} {height}] "
        arguments = ["hyprctl", "dispatch", "exec", rules + command]
    result = subprocess.run(arguments, text=True, capture_output=True, timeout=10)
    if result.returncode or "error" in result.stdout.lower():
        raise HyprlandError(result.stderr.strip() or result.stdout.strip())
    deadline = time.monotonic() + 8
    while time.monotonic() < deadline:
        client = next((c for c in hyprctl_json("clients") if c.get("mapped")
                       and c.get("initialClass", c.get("class")) == identity), None)
        if client:
            if client.get("workspace", {}).get("id") != workspace:
                raise HyprlandError("o terminal abriu em outra workspace")
            address = client.get("address", "")
            if not re.fullmatch(r"0x[0-9a-fA-F]+", address):
                raise HyprlandError("endereço do terminal inválido")
            hyprctl_batch([f"dispatch setfloating address:{address}",
                           f"dispatch resizewindowpixel exact {width} {height},address:{address}",
                           f"dispatch movewindowpixel exact {x} {y},address:{address}"])
            if current_workspace() == workspace and enabled(monitor_name):
                hyprctl_batch([f"dispatch focuswindow address:{address}"])
            return 0
        time.sleep(.04)
    raise HyprlandError("o terminal não apareceu em 8 segundos")


def main() -> int:
    commands = {
        ("toggle",): toggle,
        ("invert",): toggle_invert,
        ("drag",): drag_canvas,
        ("drag-empty",): drag_empty_canvas,
        ("stream-drag",): stream_drag_canvas,
        ("sync-state",): sync_state,
        ("scatter",): scatter_canvas,
        ("scatter-random",): scatter_random_canvas,
        ("center",): center_focused,
        ("status",): status,
    }
    try:
        args = tuple(sys.argv[1:])
        if len(args) == 7 and args[0] == "terminal-rectangle":
            return terminal_rectangle(args[1], int(args[2]), [float(v) for v in args[3:]])
        if args in commands:
            return commands[args]()
        if len(args) == 2 and args[0] == "stream-drag":
            return stream_drag_canvas(args[1])
        if len(args) == 2 and args[0] == "focus" and args[1] in DIRECTIONS:
            return focus_direction(args[1])
        if len(args) == 2 and args[0] == "focus-address":
            return focus_address(args[1])
        if len(args) == 2 and args[0] == "pan" and args[1] in DIRECTIONS:
            return pan_direction(args[1])
        if len(args) == 2 and args[0] == "zoom" and args[1] in {"in", "out"}:
            return zoom_canvas(args[1])
        print(
            "Usage: infinite-desktop toggle|invert|drag|drag-empty|stream-drag|sync-state|scatter|scatter-random|status|focus direction|focus-address address|pan direction|zoom {in|out}",
            file=sys.stderr,
        )
        return 2
    except (HyprlandError, KeyError, ValueError, OSError, subprocess.SubprocessError) as error:
        notify(f"Erro: {error}", force=bool(sys.argv[1:2] == ["terminal-rectangle"]))
        print(f"Infinite desktop: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
