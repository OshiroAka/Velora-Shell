#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
kind=${1:-}
direction=${2:-}
case "$kind:$direction" in
    volume:up) wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ ;;
    volume:down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
    brightness:up) brightnessctl -e4 -n2 set 5%+ >/dev/null ;;
    brightness:down) brightnessctl -e4 -n2 set 5%- >/dev/null ;;
    *) printf 'uso: velora-rail-adjust volume|brightness up|down\n' >&2; exit 2 ;;
esac
"$root/scripts/velora" ipc velora railLevel "$kind" >/dev/null 2>&1 || true
