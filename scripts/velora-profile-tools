#!/usr/bin/env python3
"""Capture tools used by the profile menu; no shell command interpolation."""
import datetime
import json
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile

TOOLS = {
    "area": ("grim", "slurp", "wl-copy"),
    "screen": ("grim", "wl-copy"),
    "text": ("grim", "slurp", "tesseract", "wl-copy"),
    "eyedropper": ("hyprpicker", "wl-copy"),
    "record": ("wf-recorder",),
}


def capabilities():
    requirements = dict(TOOLS)
    if not shutil.which("hyprpicker"):
        requirements["eyedropper"] = ("slurp", "grim", "magick", "wl-copy")
    return {key: {"available": not (missing := [tool for tool in tools if not shutil.which(tool)]),
                  "missing": missing} for key, tools in requirements.items()}


def notify(message):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "--app-name", "Velora", "Captura", message], check=False)


def run(action):
    state = capabilities()
    if action not in state:
        raise ValueError("Ferramenta desconhecida")
    if not state[action]["available"]:
        raise ValueError("Instale: " + ", ".join(state[action]["missing"]))
    if action in ("area", "screen"):
        subprocess.run([str(Path(__file__).with_name("velora-screenshot-select")),
                        "select" if action == "area" else "full"], check=True)
    elif action == "text":
        selection = subprocess.run(["slurp"], capture_output=True, text=True)
        if selection.returncode or not selection.stdout.strip():
            return
        with tempfile.TemporaryDirectory(prefix="velora-text-") as directory:
            image = Path(directory) / "area.png"
            subprocess.run(["grim", "-g", selection.stdout.strip(), str(image)], check=True)
            languages = subprocess.run(["tesseract", "--list-langs"], capture_output=True, text=True, check=True).stdout.splitlines()
            chosen = [language for language in ("por", "eng") if language in languages]
            command = ["tesseract", str(image), "stdout"]
            if chosen:
                command += ["-l", "+".join(chosen)]
            text = subprocess.run(command, capture_output=True, check=True).stdout
            if text.strip():
                subprocess.run(["wl-copy", "--type", "text/plain;charset=utf-8"], input=text, check=True)
                notify("Texto copiado para a área de transferência.")
            else:
                notify("Nenhum texto encontrado na área selecionada.")
    elif action == "eyedropper":
        if shutil.which("hyprpicker"):
            color = subprocess.run(["hyprpicker", "--no-fancy"], capture_output=True)
            if color.returncode or not color.stdout.strip():
                return
            value = color.stdout.strip()
        else:
            selection = subprocess.run(["slurp", "-p"], capture_output=True, text=True)
            if selection.returncode or not selection.stdout.strip():
                return
            pixel = subprocess.run(["grim", "-g", selection.stdout.strip(), "-"], capture_output=True, check=True)
            value = subprocess.run(["magick", "png:-", "-depth", "8", "-format",
                                    "#%[hex:p{0,0}]", "info:"], input=pixel.stdout,
                                   capture_output=True, check=True).stdout.strip()
        subprocess.run(["wl-copy", "--type", "text/plain"], input=value, check=True)
        notify("Cor copiada: " + value.decode(errors="replace"))
    elif action == "record":
        directory = Path.home() / "Videos" / "Screencasts"
        directory.mkdir(parents=True, exist_ok=True)
        destination = directory / ("velora-" + datetime.datetime.now().strftime("%Y-%m-%d_%H-%M-%S_%f") + ".mp4")
        process = subprocess.Popen(["wf-recorder", "-f", str(destination)], start_new_session=True)
        def stop(_signum, _frame):
            if process.poll() is None:
                process.send_signal(signal.SIGINT)
        signal.signal(signal.SIGINT, stop)
        signal.signal(signal.SIGTERM, stop)
        if process.wait() != 0:
            raise RuntimeError("Não foi possível gravar a tela.")
        notify("Gravação salva em " + str(destination))


def main():
    if len(sys.argv) == 2 and sys.argv[1] == "status":
        print(json.dumps(capabilities()))
        return 0
    try:
        if len(sys.argv) != 2:
            raise ValueError("Use status, area, screen, text, eyedropper ou record")
        run(sys.argv[1])
        return 0
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        message = str(error)
        print(message, file=sys.stderr)
        notify(message)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
