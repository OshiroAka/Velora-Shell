#!/usr/bin/env python3
"""Persistent settings shared by Velora Settings and velyrics."""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path


STATE_ROOT = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "velora-shell"
STATE_PATH = STATE_ROOT / "velyrics.json"
DEFAULTS = {
    "mode": "line",
    "wordsPerTerminal": 4,
    "fontScale": 1.0,
    "fontFamily": "Pixelon",
    "syncOffsetMs": 500.0,
}


def clamp_int(value: object, minimum: int, maximum: int, fallback: int) -> int:
    try:
        return max(minimum, min(maximum, int(round(float(value)))))
    except (TypeError, ValueError):
        return fallback


def clamp_float(value: object, minimum: float, maximum: float, fallback: float) -> float:
    try:
        return max(minimum, min(maximum, float(value)))
    except (TypeError, ValueError):
        return fallback


def normalize(data: object) -> dict[str, object]:
    source = data if isinstance(data, dict) else {}
    mode = str(source.get("mode", DEFAULTS["mode"]))
    font_family = str(source.get("fontFamily", DEFAULTS["fontFamily"])).replace("|", " ").replace("\n", " ").strip()
    return {
        "mode": mode if mode in {"line", "words"} else "line",
        "wordsPerTerminal": clamp_int(source.get("wordsPerTerminal"), 1, 12, 4),
        "fontScale": clamp_float(source.get("fontScale"), 0.5, 3.0, 1.0),
        "fontFamily": font_family[:160] or "Pixelon",
        "syncOffsetMs": clamp_float(source.get("syncOffsetMs"), 0.0, 1500.0, 500.0),
    }


def load() -> dict[str, object]:
    try:
        return normalize(json.loads(STATE_PATH.read_text(encoding="utf-8")))
    except (OSError, json.JSONDecodeError):
        return dict(DEFAULTS)


def save(data: dict[str, object]) -> dict[str, object]:
    normalized = normalize(data)
    STATE_ROOT.mkdir(parents=True, exist_ok=True)
    temporary = STATE_PATH.with_suffix(".tmp")
    temporary.write_text(json.dumps(normalized, ensure_ascii=False, separators=(",", ":")), encoding="utf-8")
    temporary.replace(STATE_PATH)
    return normalized


def print_compact(data: dict[str, object]) -> None:
    print(f"{data['mode']}|{data['wordsPerTerminal']}|{float(data['fontScale']):.2f}|{float(data['syncOffsetMs']):.1f}|{data['fontFamily']}")


def system_fonts() -> list[str]:
    try:
        result = subprocess.run(
            ["fc-list", "--format", "%{family}\n"],
            check=False,
            capture_output=True,
            text=True,
        )
    except OSError:
        return ["Pixelon"]
    families = {"Pixelon"}
    if result.returncode == 0:
        for line in result.stdout.splitlines():
            for family in line.split(","):
                clean = family.strip()
                if clean:
                    families.add(clean)
    return sorted(families, key=str.casefold)


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else "get"
    if command == "get":
        print_compact(load())
        return 0
    if command == "set" and len(sys.argv) >= 5:
        print_compact(save({
            "mode": sys.argv[2],
            "wordsPerTerminal": sys.argv[3],
            "fontScale": sys.argv[4],
            "syncOffsetMs": sys.argv[5] if len(sys.argv) > 5 else 500,
            "fontFamily": sys.argv[6] if len(sys.argv) > 6 else "Pixelon",
        }))
        return 0
    if command == "reset":
        print_compact(save(dict(DEFAULTS)))
        return 0
    if command == "json":
        print(json.dumps(load(), ensure_ascii=False, separators=(",", ":")))
        return 0
    if command == "fonts":
        print(json.dumps(system_fonts(), ensure_ascii=False, separators=(",", ":")))
        return 0
    print("usage: velora-velyrics-state get|set MODE WORDS FONT_SCALE [SYNC_OFFSET_MS] [FONT_FAMILY]|reset|json|fonts", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
